{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "rangeStrategy": "widen",
  "vulnerabilityAlerts": {
    "enabled": true,
    "groupName": "Security vulnerability updates"
  },
  "packageRules": [
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "Python non-major dependencies",
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "matchPackageNames": [
        "cloudevents"
      ],
      "allowedVersions": "< 2.0.0"
    },
    {
      "matchDatasources": [
        "terraform-version"
      ],
      "matchManagers": [
        "terraform"
      ],
      "rangeStrategy": "widen"
    }
  ]
}
