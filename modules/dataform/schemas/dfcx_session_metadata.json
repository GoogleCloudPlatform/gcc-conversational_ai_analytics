{
  "description": "DFCX session summary information",
  "partitioning": {
    "time": {
      "field": "session_start_time",
      "type": "DAY"
    }
  },
  "require_partition_filter": true,
  "schema": [
    {
      "name": "session_start_time",
      "type": "TIMESTAMP"
    },
    {
      "name": "session_id",
      "type": "STRING"
    },
    {
      "name": "project_id",
      "type": "STRING"
    },
    {
      "name": "agent_id",
      "type": "STRING"
    },
    {
      "name": "agent_name",
      "type": "STRING"
    },
    {
      "name": "location",
      "type": "STRING"
    },
    {
      "name": "session_end_time",
      "type": "TIMESTAMP"
    },
    {
      "name": "final_interaction_head_intent",
      "type": "STRING"
    },
    {
      "name": "final_action",
      "type": "STRING"
    },
    {
      "name": "final_action_started",
      "type": "BOOLEAN"
    },
    {
      "name": "final_action_ended",
      "type": "BOOLEAN"
    },
    {
      "name": "final_language_code",
      "type": "STRING"
    },
    {
      "name": "final_session_parameters",
      "type": "JSON"
    },
    {
      "name": "number_of_turns",
      "type": "INTEGER"
    },
    {
      "name": "is_escalated",
      "type": "BOOLEAN"
    },
    {
      "name": "latest_insert_time",
      "type": "TIMESTAMP"
    }
  ]
}
